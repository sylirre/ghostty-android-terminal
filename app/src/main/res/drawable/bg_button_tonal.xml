<?xml version="1.0" encoding="utf-8"?>
<!-- Compact tonal button: rounded filled surface with an accent ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/accent_translucent">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/on_accent" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_3" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
</ripple>
