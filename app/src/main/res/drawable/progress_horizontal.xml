<?xml version="1.0" encoding="utf-8"?>
<!-- Determinate progress (onboarding install): a rounded accent fill on a
     rounded surface track, replacing the square-capped platform bar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <solid android:color="@color/surface_3" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/radius_pill" />
                <solid android:color="@color/accent" />
            </shape>
        </clip>
    </item>
</layer-list>
