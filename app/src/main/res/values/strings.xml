    <!-- Settings: Keep screen on -->
    <string name="setting_keep_screen_on_title">Keep screen on</string>
    <string name="setting_keep_screen_on_summary">Keep the display awake while the terminal is in the foreground.</string>

    <!-- Settings: Rich keyboard -->
    <string name="setting_rich_keyboard_title">Rich keyboard input</string>
    <string name="setting_rich_keyboard_summary">Enable suggestions, autocorrect and swipe typing at the shell prompt. Falls back to raw keys inside full-screen apps.</string>

    <!-- Settings: Grapheme clustering -->
    <string name="setting_grapheme_title">Combine grapheme clusters</string>
    <string name="setting_grapheme_summary">Render combining marks, emoji sequences and Indic conjuncts (e.g. स्व) as single glyphs (DEC mode 2027). May misalign programs that measure text width themselves.</string>

    <!-- Settings: Touch keyboard -->
    <string name="setting_touch_keyboard_title">Show touch keyboard</string>
    <string name="setting_touch_keyboard_summary">Automatically raise the soft keyboard when opening the app, creating a session, or tapping the terminal. Search always shows the keyboard regardless.</string>

