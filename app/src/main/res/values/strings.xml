    <!-- Settings: Userland -->
    <string name="setting_userland_shell_title">Login shell</string>
    <string name="setting_userland_shell_summary">Command run as the login shell, with optional arguments (e.g. /bin/bash -l). Set automatically from the configured user; blank derives it from /etc/passwd. Takes effect only for new sessions.</string>
    <string name="setting_userland_shell_hint">/bin/bash -l</string>
    <string name="setting_userland_identity_title">User identity</string>
    <string name="setting_userland_identity_summary">Identity for userland sessions as user, user:group, uid or uid:gid. Names are resolved from /etc/passwd and /etc/group. Blank means root (0:0). Takes effect only for new sessions.</string>
    <string name="setting_userland_identity_hint">user:group or uid:gid</string>
    <string name="setting_userland_home_title">Home directory</string>
    <string name="setting_userland_home_summary">Absolute path used as HOME in userland. Set automatically from the configured user; blank derives it from /etc/passwd. Takes effect only for new sessions.</string>
    <string name="setting_userland_home_hint">/root</string>
    <string name="setting_userland_workdir_title">Working directory</string>
    <string name="setting_userland_workdir_summary">Absolute path where new userland sessions start. Blank uses the user\'s home directory. Takes effect only for new sessions.</string>
    <string name="setting_userland_workdir_hint">/root</string>
    <string name="setting_userland_workdir_default">Home directory</string>
    <string name="setting_userland_locale_title">Locale</string>
    <string name="setting_userland_locale_summary">Locale passed as LANG to userland sessions (e.g. C.UTF-8, en_US.UTF-8). Blank uses C.UTF-8. Takes effect only for new sessions.</string>
    <string name="setting_userland_locale_hint">C.UTF-8</string>
    <string name="setting_userland_locale_default">C.UTF-8</string>
    <string name="setting_userland_path_title">Executable path</string>
    <string name="setting_userland_path_summary">Colon-separated search path passed as PATH to userland sessions. Blank uses the default search path. Takes effect only for new sessions.</string>
    <string name="setting_userland_path_hint">/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin</string>
    <string name="setting_userland_path_not_absolute">Path must be absolute (start with /).</string>
    <string name="setting_userland_path_missing">Path does not exist in the userland environment.</string>

