    <!-- Onboarding (first-run intro & userland setup) -->
    <string name="onb_tagline">A complete Linux terminal for Android</string>
    <string name="onb_feat_userland_title">Full Linux, no root</string>
    <string name="onb_feat_userland_body">A real Linux userland running on a built-in AArch64 emulator. No root, no downloads — your device stays untouched.</string>
    <string name="onb_feat_terminal_title">A serious terminal</string>
    <string name="onb_feat_terminal_body">Ghostty\'s VT engine under the hood: fast, accurate rendering, true color, scrollback search and text selection.</string>
    <string name="onb_feat_touch_title">Made for touch</string>
    <string name="onb_feat_touch_body">Session tabs, an extra-keys row above the keyboard, themes, custom fonts and gestures.</string>
    <string name="onb_continue">Continue</string>
    <string name="onb_back">Back</string>
    <string name="onb_choose_title">Choose your Linux</string>
    <string name="onb_choose_subtitle">Installed offline from an image bundled with the app. You can back it up or replace it later from Settings.</string>
    <string name="onb_distro_alpine">Alpine Linux</string>
    <string name="onb_distro_alpine_blurb">Lightweight and quick to set up. BusyBox tools plus the apk package manager.</string>
    <string name="onb_distro_debian">Debian</string>
    <string name="onb_distro_debian_blurb">The classic full-size distribution: apt and a vast package archive.</string>
    <string name="onb_distro_size">%1$d MB image</string>
    <string name="onb_shell_title">Android shell only</string>
    <string name="onb_shell_blurb">Just /system/bin/sh — no Linux userland. You can set one up later from Settings.</string>
    <string name="onb_none_bundled">This build includes no Linux images, so the terminal starts with the plain Android shell.</string>
    <string name="onb_install_button">Install %1$s</string>
    <string name="onb_use_shell_button">Use Android shell</string>
