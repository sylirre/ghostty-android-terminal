    <!-- Settings: Immersive mode -->
    <string name="setting_immersive_mode_title">Immersive mode</string>
    <string name="setting_immersive_mode_summary">Hide the status and navigation bars while using the terminal. Swipe from an edge to reveal them temporarily.</string>

    <!-- Settings: Rich keyboard -->
    <string name="setting_rich_keyboard_title">Rich keyboard features</string>
    <string name="setting_rich_keyboard_summary">Enable suggestions, autocorrect and swipe typing at the shell prompt. Falls back to raw keys inside full-screen apps.</string>

    <!-- Settings: Grapheme clustering -->
    <string name="setting_grapheme_title">Combine grapheme clusters</string>
    <string name="setting_grapheme_summary">Render combining marks, emoji sequences and Indic conjuncts (e.g. स्व) as single glyphs (DEC mode 2027). May misalign programs that measure text width themselves.</string>

    <!-- Settings: Smooth scrolling -->
    <string name="setting_smooth_scroll_title">Smooth scrolling</string>
    <string name="setting_smooth_scroll_summary">Scroll the history pixel-by-pixel instead of one whole line at a time. Has no effect inside full-screen apps (vim, less).</string>

    <!-- Settings: Mouse reporting -->
    <string name="setting_mouse_tracking_title">Mouse reporting</string>
    <string name="setting_mouse_tracking_summary">Send taps and swipes to programs that support the mouse: a tap is a left click, a swipe is wheel scroll (vertical and horizontal). Only active while a program enables mouse tracking.</string>

    <!-- Settings: Tap to open links -->
    <string name="setting_tap_open_links_title">Tap to open links</string>
    <string name="setting_tap_open_links_summary">Underline OSC 8 hyperlinks and open them on tap. A preview shows the full address first so you can check where it leads.</string>

    <!-- Settings: Shell prompt navigation -->
    <string name="setting_prompt_nav_title">Shell prompt navigation</string>
    <string name="setting_prompt_nav_summary">Show top-bar buttons to jump between shell prompt lines (OSC 133) while scrolled into history. Needs shell integration that emits the sequences.</string>

    <!-- Settings: Progress reporting -->
    <string name="setting_progress_title">Progress reporting</string>
    <string name="setting_progress_summary">Show a per-tab progress bar for programs that report progress via OSC 9;4 (ConEmu style).</string>

    <!-- Settings: Clipboard write / read (OSC 52) -->
    <string name="setting_clipboard_write_title">Programs can set clipboard</string>
    <string name="setting_clipboard_write_summary">Let programs copy to the Android clipboard via OSC 52.</string>
    <string name="setting_clipboard_read_title">Programs can read clipboard</string>
    <string name="setting_clipboard_read_summary">Answer OSC 52 clipboard read requests with the clipboard contents. Off by default: any program could read what you copied, and Android limits background clipboard access.</string>

    <!-- Clipboard set via OSC 52 -->
    <string name="clipboard_set">Copied to clipboard</string>

