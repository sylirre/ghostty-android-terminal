<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spacing scale (4dp grid). -->
    <dimen name="space_1">4dp</dimen>
    <dimen name="space_2">8dp</dimen>
    <dimen name="space_3">12dp</dimen>
    <dimen name="space_4">16dp</dimen>
    <dimen name="space_5">20dp</dimen>
    <dimen name="space_6">24dp</dimen>
    <dimen name="space_7">28dp</dimen>
    <dimen name="space_8">32dp</dimen>

    <!-- Corner radii. -->
    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_md">12dp</dimen>
    <dimen name="radius_lg">16dp</dimen>
    <dimen name="radius_pill">999dp</dimen>

    <!-- Hairline stroke width. -->
    <dimen name="stroke_hairline">1dp</dimen>

    <!-- Minimum comfortable touch target. -->
    <dimen name="touch_min">48dp</dimen>

    <!-- Square top-bar icon buttons (new-tab, search, settings). -->
    <dimen name="icon_button">44dp</dimen>

    <!-- Extra-keys keycap metrics. Caps flex to fill each row (weight-based), so
         there is no fixed min width; padding centers the label in the cap. -->
    <dimen name="key_pad_h">6dp</dimen>
    <dimen name="key_pad_v">8dp</dimen>
    <dimen name="key_gap">4dp</dimen>
    <dimen name="key_radius">10dp</dimen>
    <!-- Inset of the swipe-up secondary hint from a cap's top-right corner. -->
    <dimen name="key_hint_inset">4dp</dimen>
    <!-- Leading profile-switch column width (when the switcher is enabled). -->
    <dimen name="key_switch_width">40dp</dimen>

    <!-- Session tab metrics. Sized so two labeled pills (each with a close
         button) plus the pinned + still fit the 320dp-wide floor device.
         tab_indicator is both the active pill's accent border width and the
         progress ring's stroke. -->
    <dimen name="tab_pad_h">12dp</dimen>
    <dimen name="tab_pad_v">9dp</dimen>
    <dimen name="tab_indicator">2dp</dimen>
    <dimen name="tab_max_width">132dp</dimen>

    <!-- Chrome text sizes. -->
    <dimen name="text_title">19sp</dimen>
    <dimen name="text_row_title">16sp</dimen>
    <dimen name="text_row_summary">13sp</dimen>
    <dimen name="text_section">13sp</dimen>
    <!-- Top-bar text actions (Done, Reset) and dialog fields. -->
    <dimen name="text_action">15sp</dimen>
    <!-- Current-value read-out on settings rows. -->
    <dimen name="text_row_value">14sp</dimen>
    <!-- Session tab labels. -->
    <dimen name="text_tab">14sp</dimen>
    <!-- Glyph-only top-bar buttons (search, settings, prompt nav). -->
    <dimen name="text_icon_glyph">18sp</dimen>
    <!-- Smallest captions (swatch labels, inline errors). -->
    <dimen name="text_caption">12sp</dimen>

    <!-- Screen top bar (back + title + trailing actions). -->
    <dimen name="top_bar_height">56dp</dimen>
    <dimen name="elevation_bar">3dp</dimen>

    <!-- Slider value read-out reserve, so digits don't jiggle the bar. -->
    <dimen name="slider_readout_min">52dp</dimen>
    <!-- Themed terminal scrollbar thumb width. -->
    <dimen name="scrollbar_width">4dp</dimen>
    <!-- Determinate progress track height (onboarding install). -->
    <dimen name="progress_height">6dp</dimen>
    <!-- Oversized hero tiles (onboarding art). -->
    <dimen name="radius_hero">22dp</dimen>

    <!-- Color picker geometry. -->
    <dimen name="picker_field_height">180dp</dimen>
    <dimen name="picker_bar_height">20dp</dimen>
    <dimen name="picker_swatch_height">40dp</dimen>
    <dimen name="picker_chip">28dp</dimen>
</resources>
