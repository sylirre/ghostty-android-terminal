<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen terminal theme editor. ThemeActivity fills the swatch grid
     programmatically (one theme_swatch per editable color) and drives the
     preview, picker label, and action buttons. All @id/theme_* ids and the
     widget types are relied on by ThemeActivity; only the chrome around them
     is styled here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_base">

    <io.github.sylirre.terminal.ui.TopBarView
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/theme_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="@dimen/space_7">

            <!-- Live preview, framed in a card. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:background="@drawable/bg_card">

                <io.github.sylirre.terminal.ui.ThemePreviewView
                    android:id="@+id/theme_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </FrameLayout>

            <!-- Background wallpaper (a global setting, independent of colors). -->
            <TextView
                style="@style/SectionHeader"
                android:text="@string/theme_section_background" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_bg_image_label"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_row_title" />

                    <Button
                        android:id="@+id/theme_bg_choose"
                        style="@style/ButtonTonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_bg_image_choose" />

                    <Button
                        android:id="@+id/theme_bg_remove"
                        style="@style/ButtonText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/theme_bg_image_remove" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/theme_bg_opacity_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_bg_image_opacity"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_row_summary" />

                    <SeekBar
                        android:id="@+id/theme_bg_opacity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:max="100" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/theme_bg_blur_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/space_1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_bg_image_blur"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_row_summary" />

                    <SeekBar
                        android:id="@+id/theme_bg_blur"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:max="100" />

                </LinearLayout>

            </LinearLayout>

            <!-- Cursor shape + blink (global, like the background image). -->
            <TextView
                style="@style/SectionHeader"
                android:text="@string/theme_section_cursor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_cursor_style"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_row_title" />

                    <Button
                        android:id="@+id/theme_cursor_style"
                        style="@style/ButtonTonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_cursor_blink"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_row_title" />

                    <Switch
                        android:id="@+id/theme_cursor_blink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

            <!-- Terminal fonts (global appearance, independent of the color theme). -->
            <TextView
                style="@style/SectionHeader"
                android:text="@string/theme_section_fonts" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_font_default"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_row_title" />

                    <Button
                        android:id="@+id/theme_font_default_choose"
                        style="@style/ButtonTonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_font_choose" />

                    <Button
                        android:id="@+id/theme_font_default_remove"
                        style="@style/ButtonText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/theme_font_remove" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_font_bold"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_row_title" />

                    <Button
                        android:id="@+id/theme_font_bold_choose"
                        style="@style/ButtonTonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_font_choose" />

                    <Button
                        android:id="@+id/theme_font_bold_remove"
                        style="@style/ButtonText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/theme_font_remove" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_font_italic"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_row_title" />

                    <Button
                        android:id="@+id/theme_font_italic_choose"
                        style="@style/ButtonTonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_font_choose" />

                    <Button
                        android:id="@+id/theme_font_italic_remove"
                        style="@style/ButtonText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/theme_font_remove" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_font_bold_italic"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_row_title" />

                    <Button
                        android:id="@+id/theme_font_bold_italic_choose"
                        style="@style/ButtonTonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_font_choose" />

                    <Button
                        android:id="@+id/theme_font_bold_italic_remove"
                        style="@style/ButtonText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/theme_font_remove" />

                </LinearLayout>

            </LinearLayout>

            <!-- Active theme, actions, and the editable color swatches. -->
            <TextView
                style="@style/SectionHeader"
                android:text="@string/theme_section_theme" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_picker_label"
                        android:textColor="@color/text_secondary" />

                    <Button
                        android:id="@+id/theme_name"
                        style="@style/ButtonTonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/theme_save"
                            style="@style/ButtonTonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="@string/theme_save" />

                        <Button
                            android:id="@+id/theme_save_as"
                            style="@style/ButtonTonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="@string/theme_save_as" />

                        <Button
                            android:id="@+id/theme_revert"
                            style="@style/ButtonTonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="@string/theme_revert" />

                        <Button
                            android:id="@+id/theme_rename"
                            style="@style/ButtonTonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="@string/theme_rename" />

                        <Button
                            android:id="@+id/theme_delete"
                            style="@style/ButtonTextDanger"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_delete" />

                    </LinearLayout>

                </HorizontalScrollView>

                <GridLayout
                    android:id="@+id/theme_swatches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:columnCount="4" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
