<?xml version="1.0" encoding="utf-8"?>
<!-- A row-break divider in the Extra-keys editor's "Enabled keys" list: a drag
     handle, a centred "new row" label, and a remove (merge) button. Carries the
     same row_handle / row_remove ids as extra_keys_edit_row so ExtraKeysActivity
     and its DragController treat keys and dividers uniformly. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FF101018"
    android:minHeight="40dp"
    android:layout_marginTop="1dp"
    android:paddingLeft="8dp"
    android:paddingRight="8dp">

    <TextView
        android:id="@+id/row_handle"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/extra_keys_drag_handle"
        android:textColor="#FF6C6C7A"
        android:textSize="20sp"
        android:paddingLeft="12dp"
        android:paddingRight="16dp"
        android:contentDescription="@string/extra_keys_drag_description" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/extra_keys_row_break"
        android:textColor="#FF7C7C8A"
        android:textSize="12sp"
        android:textStyle="italic"
        android:textAllCaps="true"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/row_remove"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/extra_keys_remove_label"
        android:textColor="#FF8A8A99"
        android:textSize="18sp"
        android:paddingLeft="16dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/extra_keys_row_break_remove_description" />

</LinearLayout>
