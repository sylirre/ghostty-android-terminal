<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: scrolling tab strip plus fixed search + settings buttons. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:background="@color/surface_1">

            <sh.easycli.proot.ui.TabStripView
                android:id="@+id/tabs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/search_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="@string/search_button_icon"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:background="@drawable/bg_toolbar_icon"
                android:contentDescription="@string/search_button_description"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/settings_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="@string/settings_button_icon"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:background="@drawable/bg_toolbar_icon"
                android:contentDescription="@string/settings_button_description"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Hairline separating the top bar from the terminal surface. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Find bar; hidden until the search button is tapped. -->
        <sh.easycli.proot.ui.SearchBarView
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <sh.easycli.proot.ui.TerminalView
            android:id="@+id/terminal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />

        <sh.easycli.proot.ui.ExtraKeysView
            android:id="@+id/extra_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- One-time Debian rootfs extraction status; gone otherwise. -->
    <TextView
        android:id="@+id/install_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:visibility="gone" />

</FrameLayout>
