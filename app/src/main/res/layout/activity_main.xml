<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: scrolling tab strip plus fixed search + settings buttons. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:background="@color/surface_1">

            <io.github.sylirre.terminal.ui.TabStripView
                android:id="@+id/tabs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/prompt_prev_button"
                android:layout_width="@dimen/icon_button"
                android:layout_height="@dimen/icon_button"
                android:layout_marginStart="4dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="@string/prompt_prev_icon"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:background="@drawable/bg_chip"
                android:contentDescription="@string/prompt_prev_description"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/prompt_next_button"
                android:layout_width="@dimen/icon_button"
                android:layout_height="@dimen/icon_button"
                android:layout_marginStart="4dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="@string/prompt_next_icon"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:background="@drawable/bg_chip"
                android:contentDescription="@string/prompt_next_description"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/search_button"
                android:layout_width="@dimen/icon_button"
                android:layout_height="@dimen/icon_button"
                android:layout_marginStart="4dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="@string/search_button_icon"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:background="@drawable/bg_chip"
                android:contentDescription="@string/search_button_description"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/settings_button"
                android:layout_width="@dimen/icon_button"
                android:layout_height="@dimen/icon_button"
                android:layout_marginStart="4dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="@string/settings_button_icon"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:background="@drawable/bg_chip"
                android:contentDescription="@string/settings_button_description"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Hairline separating the top bar from the terminal surface. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Find bar; hidden until the search button is tapped. -->
        <io.github.sylirre.terminal.ui.SearchBarView
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <io.github.sylirre.terminal.ui.TerminalView
            android:id="@+id/terminal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />

        <io.github.sylirre.terminal.ui.ExtraKeysView
            android:id="@+id/extra_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</FrameLayout>
