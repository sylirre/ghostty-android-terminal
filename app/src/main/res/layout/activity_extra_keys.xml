<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen extra-keys toolbar editor, reached from Settings. A fixed top
     bar with a title and actions, then a scrolling body. ExtraKeysActivity
     fills preview_rows / enabled_list / available_grid at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: title + Reset + Done. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:background="@color/surface_1">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/TopBarTitle"
                android:text="@string/extra_keys_title"
                android:paddingLeft="20dp" />

            <TextView
                android:id="@+id/extra_keys_reset"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/extra_keys_reset"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/extra_keys_done"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/extra_keys_done"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingLeft="16dp"
                android:paddingRight="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <ScrollView
            android:id="@+id/page_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="32dp">

                <!-- Live preview of the toolbar as configured: one strip per row. -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/extra_keys_section_preview" />

                <LinearLayout
                    android:id="@+id/preview_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Enabled keys: reorder by dragging the handle, remove with ✕. -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/extra_keys_section_enabled" />

                <TextView
                    android:id="@+id/enabled_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extra_keys_empty"
                    android:textColor="@color/text_tertiary"
                    android:textSize="14sp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/enabled_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/extra_keys_add_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extra_keys_add_row"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:layout_marginTop="8dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Available keys to add, plus a custom-text entry point. -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/extra_keys_section_available" />

                <GridLayout
                    android:id="@+id/available_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/extra_keys_add_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extra_keys_add_custom"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:layout_marginTop="12dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/extra_keys_add_combo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extra_keys_add_combo"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>
