<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen extra-keys editor, reached from Settings. A fixed top bar, then
     a scrolling body: a profile bar (switch/add layouts) and the live WYSIWYG
     keyboard grid. ExtraKeysActivity fills profile_bar / grid at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <io.github.sylirre.terminal.ui.TopBarView
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ScrollView
            android:id="@+id/page_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="@dimen/space_8">

                <!-- Named layouts: switch, add, rename/duplicate/delete. -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/extra_keys_section_profiles" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:id="@+id/profile_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <!-- Row height: a dp slider; the grid below previews the chosen
                     height live (WYSIWYG). -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/extra_keys_section_row_height" />

                <LinearLayout
                    android:id="@+id/row_height_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <!-- The live keyboard: tap a key to edit, long-press to drag. -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/extra_keys_section_grid" />

                <LinearLayout
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/extra_keys_add_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extra_keys_add_row"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:layout_marginTop="8dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extra_keys_grid_hint"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"
                    android:paddingTop="12dp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>
