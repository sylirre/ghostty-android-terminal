<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen extra-keys toolbar editor, reached from Settings. Mirrors
     activity_theme.xml: a fixed top bar with a title and actions, then a
     scrolling body. ExtraKeysActivity fills preview_row / enabled_list /
     available_grid at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: title + Reset + Done. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FF14141A">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/extra_keys_title"
                android:textColor="#FFEAEAF0"
                android:textSize="18sp"
                android:paddingLeft="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

            <TextView
                android:id="@+id/extra_keys_reset"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/extra_keys_reset"
                android:textColor="#FF9999A6"
                android:textSize="15sp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/extra_keys_done"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/extra_keys_done"
                android:textColor="#FF6E8BFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingLeft="16dp"
                android:paddingRight="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/page_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <!-- Live preview of the toolbar as configured. -->
                <TextView
                    style="@style/ExtraKeysSectionHeader"
                    android:text="@string/extra_keys_section_preview" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FF21212A"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/preview_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <!-- Enabled keys: reorder by dragging the handle, remove with ✕. -->
                <TextView
                    style="@style/ExtraKeysSectionHeader"
                    android:text="@string/extra_keys_section_enabled" />

                <TextView
                    android:id="@+id/enabled_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extra_keys_empty"
                    android:textColor="#FF8A8A99"
                    android:textSize="14sp"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/enabled_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Available keys to add, plus a custom-text entry point. -->
                <TextView
                    style="@style/ExtraKeysSectionHeader"
                    android:text="@string/extra_keys_section_available" />

                <GridLayout
                    android:id="@+id/available_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/extra_keys_add_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extra_keys_add_custom"
                    android:textColor="#FF6E8BFF"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:layout_marginTop="8dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/extra_keys_add_combo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extra_keys_add_combo"
                    android:textColor="#FF6E8BFF"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>
