<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen extra-keys editor, reached from Settings. A fixed top bar, then
     a scrolling body: a profile bar (switch/add layouts) and the live WYSIWYG
     keyboard grid. ExtraKeysActivity fills profile_bar / grid at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <io.github.sylirre.terminal.ui.TopBarView
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ScrollView
            android:id="@+id/page_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:fillViewport="true">

            <!-- No container side padding: the section headers pad themselves
                 and the sections carry margins, so the keyboard preview can
                 run full-bleed at the real toolbar's exact width (WYSIWYG). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_8">

                <!-- Named layouts: switch, add, rename/duplicate/delete. -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/extra_keys_section_profiles" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_marginEnd="@dimen/space_4"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_3"
                    android:paddingEnd="@dimen/space_3"
                    android:paddingTop="@dimen/space_3"
                    android:paddingBottom="@dimen/space_3"
                    android:background="@drawable/bg_card">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/profile_bar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                </LinearLayout>

                <!-- Row height: a dp slider; the grid below previews the chosen
                     height live (WYSIWYG). -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/extra_keys_section_row_height" />

                <LinearLayout
                    android:id="@+id/row_height_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_marginEnd="@dimen/space_4"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_3"
                    android:paddingEnd="@dimen/space_3"
                    android:paddingTop="@dimen/space_2"
                    android:paddingBottom="@dimen/space_2"
                    android:background="@drawable/bg_card" />

                <!-- The live keyboard: tap a key to edit, long-press to drag.
                     Full-bleed and framed with the real toolbar's surface
                     (code adds the matching key-gap padding), so the preview
                     is the toolbar, at its true width. -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/extra_keys_section_grid" />

                <LinearLayout
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_toolbar_top" />

                <TextView
                    android:id="@+id/extra_keys_add_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_marginEnd="@dimen/space_4"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/extra_keys_add_row"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_action"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_4"
                    android:paddingBottom="@dimen/space_4"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_marginEnd="@dimen/space_4"
                    android:text="@string/extra_keys_grid_hint"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_row_summary"
                    android:paddingTop="@dimen/space_3"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>
