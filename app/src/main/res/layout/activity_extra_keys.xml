<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen extra-keys editor, reached from Settings. A fixed top bar, then
     a scrolling body: a profile bar (switch/add layouts) and the live WYSIWYG
     keyboard grid. ExtraKeysActivity fills profile_bar / grid at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: title + Reset + Done. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:background="@color/surface_1">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/TopBarTitle"
                android:text="@string/extra_keys_title"
                android:paddingLeft="20dp" />

            <TextView
                android:id="@+id/extra_keys_reset"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/extra_keys_reset"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/extra_keys_done"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/extra_keys_done"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingLeft="16dp"
                android:paddingRight="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <ScrollView
            android:id="@+id/page_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="32dp">

                <!-- Named layouts: switch, add, rename/duplicate/delete. -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/extra_keys_section_profiles" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:id="@+id/profile_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <!-- Row height: single-select pills; the grid below previews the
                     chosen height live (WYSIWYG). -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/extra_keys_section_row_height" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:id="@+id/row_height_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <!-- The live keyboard: tap a key to edit, long-press to drag. -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/extra_keys_section_grid" />

                <LinearLayout
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/extra_keys_add_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extra_keys_add_row"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:layout_marginTop="8dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extra_keys_grid_hint"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"
                    android:paddingTop="12dp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>
