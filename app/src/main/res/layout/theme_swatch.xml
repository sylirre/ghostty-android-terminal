<?xml version="1.0" encoding="utf-8"?>
<!-- One editable color tile in ThemeActivity's grid: a color box above a
     short label. ThemeActivity sets the box color, the label, and the tap
     handler; the width is set per-cell so columns share the grid evenly. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="4dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- A 1dp light frame so dark swatches (black, the dark background) stay
         visible against the dark editor background. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:padding="1dp"
        android:background="#55FFFFFF">

        <View
            android:id="@+id/swatch_color"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <TextView
        android:id="@+id/swatch_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>
