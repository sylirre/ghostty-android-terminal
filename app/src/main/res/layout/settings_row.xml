<?xml version="1.0" encoding="utf-8"?>
<!-- One settings row. Line 1 holds the title plus, on the trailing side,
     whichever applies: the current value (short values only), the Setting's
     control (a Switch), and a disclosure chevron for rows that open another
     screen. The summary sits under it at full width. Values too long for the
     trailing slot move into @id/setting_value_below (full width, middle
     ellipsis); sliders render full-width into @id/setting_control_wide.
     SettingsActivity owns the adaptive placement (see bindValueLabel).
     Rendered inside a grouped card, so the row itself is transparent with a
     ripple. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:minHeight="60dp"
    android:paddingStart="@dimen/space_4"
    android:paddingEnd="@dimen/space_4"
    android:paddingTop="@dimen/space_3"
    android:paddingBottom="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/setting_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/SettingsRowTitle" />

        <FrameLayout
            android:id="@+id/setting_value_inline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/setting_control"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/setting_chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:src="@drawable/ic_glyph_chevron_right"
            android:tint="@color/text_tertiary"
            android:importantForAccessibility="no"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/setting_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        style="@style/SettingsRowSummary" />

    <FrameLayout
        android:id="@+id/setting_value_below"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/setting_control_wide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:visibility="gone" />

</LinearLayout>
