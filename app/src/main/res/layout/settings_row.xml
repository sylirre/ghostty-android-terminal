<?xml version="1.0" encoding="utf-8"?>
<!-- One settings row: a title + one-line description on the left, and a
     slot on the right that SettingsActivity fills with the Setting's control
     (a Switch today; a value label for pickers/actions). Rendered inside a
     grouped card, so the row itself is transparent with a ripple. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:minHeight="60dp"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/setting_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/SettingsRowTitle" />

        <TextView
            android:id="@+id/setting_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            style="@style/SettingsRowSummary" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/setting_control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp" />

</LinearLayout>
